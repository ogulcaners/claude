{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADA Action Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "session_id",
    "action",
    "arguments",
    "preconditions",
    "timeout_ms"
  ],
  "properties": {
    "trace_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "speak",
        "stop_speaking",
        "lookup_product",
        "lookup_price",
        "resolve_destination",
        "navigate_to_destination",
        "cancel_navigation",
        "request_staff",
        "perform_authorized_expression"
      ]
    },
    "arguments": {
      "type": "object"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 300000
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
