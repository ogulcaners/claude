{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADA Event Log",
  "type": "object",
  "required": [
    "timestamp",
    "trace_id",
    "event_type",
    "component",
    "payload"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_type": {
      "type": "string"
    },
    "component": {
      "type": "string"
    },
    "prompt_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "latency_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "payload": {
      "type": "object"
    },
    "privacy_class": {
      "type": "string",
      "enum": [
        "public_operational",
        "internal",
        "restricted_personal"
      ]
    }
  }
}
